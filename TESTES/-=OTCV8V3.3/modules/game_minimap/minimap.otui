MinimapWindow
  id: minimapWindow
  !text: tr('Minimap')
  icon: /images/TOPBUTTONS_REWORK/ICON_MINIMAP
  @onClose: modules.game_minimap.onMiniWindowClose()
  &save: true
  &autoOpen: 1

  Button
    id: closeMinimapButton
    text: X
    width: 18
    height: 18
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 4
    margin-right: 4
    @onClick: modules.game_minimap.toggle()