SlotBarMini < UIWidget
  size: 68 52
  anchors.top: parent.top
  anchors.left: parent.left
  image-source: /images/game/pokebar/slotbar_mini
  image-clip: 0 80 80 60
  draggable: true
  phantom: false
  margin-left: 8
  margin-top: 0
  &dragLeave: 0
  &moveSlot: true

  $!first:
    anchors.top: prev.bottom
    margin-top: 2

  $checked:
    size: 68 68
    image-clip: 0 0 80 80

  $on:
    image-clip: 0 80 80 80

  UIWidget
    id: image
    size: 44 44
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    opacity: 1
    margin-left: 2
    image-fixed-ratio: true
    image-smooth: true

    $disabled:
      opacity: 0.3

    $checked:
      size: 58 58

  UIWidget
    id: framePokemon
    size: 46 46
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/game/pokebar/slotbar_mini_moldura
    image-clip: 0 80 54 60
    phantom: true
    margin-left: 2
    z: 5

    $disabled:
      opacity: 1

    $checked:
      size: 60 60
      image-clip: 0 0 74 80

  Panel
    id: elements
    width: 20
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    layout: verticalBox
    &px: 20
    margin: 0 0 0 -8

    $checked:
      width: 24
      &px: 24
      margin: 0 0 0 -10

Panel
  id: panelBar
  size: 56 72
  pos: 10 150
  focusable: false
  &currentMode: 2
  &orientation: 2
  &isEditingMode: false
