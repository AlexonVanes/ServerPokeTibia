widgetLoadImage < UIWidget
  size: 100 100
  image-source: images/profile/editprofile/widget
  image-border: 20
  &updateOnStates: |
    function(self)
      local children = self:getChildren()
      for i=1,#children do
        children[i]:setOn(self:isFocused())
        if self:isFocused() then
          self.slot:setOpacity(1)
        else
          self.slot:setOpacity(0.5)
        end
      end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: self:updateOnStates()
  change-cursor-image: true
  cursor: pointer
  $focus:
    image-source: images/profile/editprofile/widget_selected
  UIWidget
    id: slot
    size: 80 80
    image-source: /perfil/square/male/1
    clipping: true
    phantom: true
    anchors.verticalCenter: parent.verticalCenter
    anchors.horizontalCenter: parent.horizontalCenter

