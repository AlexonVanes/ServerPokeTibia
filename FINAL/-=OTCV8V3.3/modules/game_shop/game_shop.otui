ShopPanelDark < UIWidget
  background: alpha
  border-width: 0
  image-source: assets/ui/panel_navy_dark
  image-border: 14
  image-smooth: true

ShopPanelMid < UIWidget
  background: alpha
  border-width: 0
  image-source: assets/ui/panel_navy_mid
  image-border: 14
  image-smooth: true

ShopPanelInset < UIWidget
  background: alpha
  border-width: 0
  image-source: assets/ui/panel_navy_inset
  image-border: 12
  image-smooth: true

ShopButtonBase < UIButton
  background: alpha
  border-width: 0
  image-source: assets/ui/btn_cyan
  image-border: 24
  image-smooth: true
  change-cursor-image: true
  cursor: pointer
  color: #0b1020
  text-align: center
  text-auto-resize: false
  font: sono_bold_12
  padding: 0 18
  size: 160 48

  $hover !disabled:
    image-source: assets/ui/btn_cyan_hover

ShopButtonPrimary < ShopButtonBase
  image-source: assets/ui/btn_cyan
  $hover !disabled:
    image-source: assets/ui/btn_cyan_hover

ShopButtonSecondary < ShopButtonBase
  image-source: assets/ui/btn_navy
  color: #d9e0ee
  $hover !disabled:
    image-source: assets/ui/btn_navy_light

ShopButtonGreen < ShopButtonBase
  image-source: assets/ui/btn_green
  color: #06140a
  $hover !disabled:
    image-source: assets/ui/btn_green_hover

ShopButtonAmber < ShopButtonBase
  image-source: assets/ui/btn_amber
  color: #111827
  $hover !disabled:
    image-source: assets/ui/btn_amber_hover

ShopToggle < ShopButtonBase
  image-source: assets/ui/btn_navy
  color: #8ea0c2
  $hover !disabled:
    image-source: assets/ui/btn_navy_light
  $on:
    image-source: assets/ui/btn_cyan
    color: #0b1020
  $on $hover:
    image-source: assets/ui/btn_cyan_hover

ShopCloseButton < UIButton
  size: 32 32
  background: alpha
  border-width: 0
  image-source: assets/ui/btn_navy
  image-border: 16
  image-smooth: true
  text: "X"
  color: #95a0b5
  font: sono_bold_12
  text-align: center
  change-cursor-image: true
  cursor: pointer
  $hover:
    image-source: assets/ui/btn_red
    color: #ffffff

ShopScrollSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  image-source: assets/ui/scroll_slider
  image-border: 4
  image-smooth: true
  $hover:
    image-source: assets/ui/scroll_slider_hover
  $pressed:
    image-source: assets/ui/scroll_slider_hover
  $disabled:
    opacity: 0.4

ShopVerticalScrollBar < UIScrollBar
  orientation: vertical
  width: 12
  height: 40
  image-source: assets/ui/scroll_track
  image-border: 6
  image-smooth: true
  image-color: #050810
  pixels-scroll: true

  UIButton
    id: decrementButton
    size: 1 1
    visible: false

  UIButton
    id: incrementButton
    size: 1 1
    visible: false

  ShopScrollSlider
    size: 10 30

ShopHorizontalScrollBar < UIScrollBar
  orientation: horizontal
  height: 8
  width: 40
  image-source: assets/ui/scroll_track
  image-border: 4
  image-smooth: true
  pixels-scroll: true

  UIButton
    id: decrementButton
    size: 1 1
    visible: false

  UIButton
    id: incrementButton
    size: 1 1
    visible: false

  ShopScrollSlider
    size: 30 8

quantityWindow < UIWindow
  anchors.centerIn: parent
  image-source: assets/ui/panel_window
  image-border: 22
  image-smooth: true
  size: 280 200
  font: sono_bold_12
  color: #ffffff
  @onEscape: self:destroy()

  UIWidget
    id: modalHeader
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 44
    margin-top: 12
    margin-left: 14
    margin-right: 14
    image-source: assets/ui/panel_navy_dark
    image-border: 12
    image-smooth: true

  UIWidget
    anchors.top: modalHeader.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    size: 140 2
    background: #22d3ee

  Label
    id: topText
    anchors.fill: modalHeader
    margin: 0 8
    text-auto-resize: false
    font: future-earth-16px
    color: #ffffff
    text-align: center
    phantom: true
    margin-top: 0

  UIWidget
    id: priceFrame
    anchors.top: modalHeader.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 18
    size: 200 32
    image-source: assets/ui/panel_navy_inset
    image-border: 12
    image-color: #0e1424

  UIWidget
    id: minusButton
    anchors.left: priceFrame.left
    anchors.verticalCenter: priceFrame.verticalCenter
    margin-left: 6
    size: 26 26
    image-source: assets/ui/btn_navy
    image-border: 13
    image-smooth: true
    text: "-"
    text-align: center
    font: sono_bold_14
    color: #d9e0ee
    change-cursor-image: true
    cursor: pointer
    $hover:
      image-source: assets/ui/btn_navy_light

  Label
    id: precoItem
    anchors.fill: priceFrame
    margin: 0 36
    font: sono_bold_14
    color: #22d3ee
    text-align: center
    text-auto-resize: false
    phantom: true

  UIWidget
    id: plusButton
    anchors.right: priceFrame.right
    anchors.verticalCenter: priceFrame.verticalCenter
    margin-right: 6
    size: 26 26
    image-source: assets/ui/btn_navy
    image-border: 13
    image-smooth: true
    text: "+"
    text-align: center
    font: sono_bold_14
    color: #d9e0ee
    change-cursor-image: true
    cursor: pointer
    $hover:
      image-source: assets/ui/btn_navy_light

  Label
    id: quantidadeLabel
    anchors.top: priceFrame.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    size: 100 16
    font: sono_bold_12
    color: #8ea0c2
    text-align: center
    text: "1 x"
    phantom: true

  HorizontalScrollBar
    id: quantidadeBuy
    minimum: 1
    maximum: 10000
    anchors.top: quantidadeLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 36
    margin-right: 36
    step: 1
    @onValueChange: modules.game_shop.changeQuantidade(self:getValue())

  ShopButtonGreen
    id: buyButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 4
    text: "COMPRAR"
    size: 130 48

  ShopButtonAmber
    id: sellButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 4
    text: "VENDER"
    size: 130 48
    visible: false

  ShopCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 12
    @onClick: modules.game_shop.destroyWindow()

itemClube < UIItem
  image-source: assets/ui/panel_navy_inset
  image-border: 10
  image-smooth: true
  margin-left: 6
  margin-right: -6
  margin-top: 8
  margin-bottom: -8

baseCategoria < UIWidget
  size: 220 50
  background: alpha
  border-width: 0
  image-source: assets/ui/panel_navy_mid
  image-border: 14
  image-smooth: true
  image-color: #ffffff
  text-offset: 0 8
  text-align: center
  font: sono_bold_14
  color: #c5cad6
  change-cursor-image: true
  cursor: pointer

  &updateOnStates: |
    function(self)
      local children = self:getChildren()
      for i=1,#children do
        children[i]:setOn(self:isFocused())
      end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: self:updateOnStates()

  $hover !$focus:
    image-color: #c8e8ff
    color: #ffffff

  $focus:
    image-color: #1f3760
    color: #5fe7ff

  UIWidget
    id: stripe
    size: 4 26
    background: #22d3ee
    border-width: 0
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 7
    opacity: 0.0
    phantom: true

    $on:
      opacity: 1.0

baseItem < UIWidget
  size: 100 116
  background: alpha
  border-width: 0
  image-source: assets/ui/panel_navy_mid
  image-border: 12
  image-smooth: true
  margin: 1
  change-cursor-image: true
  cursor: pointer

  UIWidget
    id: hoverGlow
    anchors.fill: parent
    image-source: assets/ui/panel_navy_inset
    image-border: 12
    image-smooth: true
    image-color: #22d3ee
    opacity: 0
    phantom: true

  UIWidget
    id: itemFrame
    size: 64 64
    background: alpha
    border-width: 0
    image-source: ~
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 22
    phantom: true

  UIItem
    id: item
    size: 48 48
    anchors.centerIn: itemFrame
    phantom: true
    virtual: true

  Label
    id: name
    color: #e8ecf4
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    text-auto-resize: true
    margin-top: 6
    font: sono_bold_12
    phantom: true

  UIWidget
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 14
    margin-right: 14
    margin-bottom: 30
    height: 1
    background: #22d3ee
    opacity: 0.25
    phantom: true

  UIWidget
    id: priceChip
    size: 84 22
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 6
    background: alpha
    border-width: 0
    image-source: ~
    phantom: true

  UIItem
    id: icon_currency
    size: 18 18
    anchors.left: priceChip.left
    anchors.verticalCenter: priceChip.verticalCenter
    margin-left: 8
    phantom: true

  Label
    id: preco
    text-auto-resize: false
    font: sono_bold_14
    anchors.left: icon_currency.right
    anchors.right: priceChip.right
    anchors.verticalCenter: priceChip.verticalCenter
    margin-left: 6
    margin-right: 8
    color: #22d3ee
    text-align: left
    phantom: true

  UIWidget
    id: tooltipName
    anchors.fill: parent
    phantom: true

  @onClick: modules.game_shop.createWindow(self:getId(), self)

