packItemWidget < UIWidget
  size: 32 32
  image-source: assets/ui/panel_navy_inset
  image-border: 16
  image-smooth: true
  image-color: #ffffff
  padding: 3

  UIItem
    id: itemWidget
    size: 26 26
    anchors.centerIn: parent
    virtual: true
    phantom: true

UIWindow
  id: gameShop
  anchors.centerIn: parent
  size: 800 596
  image-source: assets/ui/panel_window
  image-border: 22
  image-smooth: true
  text: ""
  padding: 0
  focusable: true
  @onEscape: self:hide()
  @onFocusChange: if self:isFocused() then self:raise() end
  @onSetup: self:setDraggable(true)

  UIWidget
    id: headerBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 76
    margin-top: 14
    margin-left: 16
    margin-right: 16
    image-source: assets/ui/panel_navy_dark
    image-border: 14
    image-smooth: true

  UIWidget
    id: titleStripe
    anchors.top: headerBar.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    size: 220 2
    background: #22d3ee
    border-width: 0

  UIWidget
    id: logoChip
    anchors.left: headerBar.left
    anchors.verticalCenter: headerBar.verticalCenter
    margin-left: 14
    size: 56 56
    image-source: assets/ui/panel_navy_inset
    image-border: 12
    image-smooth: true
    image-color: #0a1020

    UIWidget
      id: logoIcon
      anchors.centerIn: parent
      size: 32 32
      image-source: assets/topbutton/diamond
      image-smooth: true
      phantom: true

  UIWidget
    id: logoAccent
    size: 32 4
    background: #22d3ee
    anchors.horizontalCenter: logoChip.horizontalCenter
    anchors.bottom: logoChip.bottom
    margin-bottom: 6

  Label
    id: shopTitle
    !text: tr('SPACE SHOP')
    anchors.left: logoChip.right
    anchors.right: parent.right
    anchors.top: headerBar.top
    margin-left: 18
    margin-right: 80
    margin-top: 14
    font: future-earth-26
    color: #ffffff
    text-auto-resize: false
    text-align: left
    phantom: true

  Label
    id: shopSubtitle
    !text: tr('Compre items, pokemons, outfits e packs exclusivos')
    anchors.top: shopTitle.bottom
    anchors.left: shopTitle.left
    anchors.right: shopTitle.right
    margin-top: 16
    font: sono_bold_12
    color: #8ea0c2
    text-auto-resize: false
    text-align: left
    phantom: true

  ShopCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 22
    margin-right: 22
    @onClick: self:getParent():hide()

  ShopToggle
    id: modeButton
    anchors.top: titleStripe.bottom
    anchors.left: sidebarFrame.right
    margin-top: 14
    margin-left: 52
    text: "Modo: Compra"
    size: 138 48
    @onClick: |
      local currentText = self:getText()
      if currentText == "Modo: Compra" then
        self:setText("Modo: Venda")
        self:setOn(true)
        modules.game_shop.setMode("sell")
      else
        self:setText("Modo: Compra")
        self:setOn(false)
        modules.game_shop.setMode("buy")
      end

  ShopButtonSecondary
    id: typeMoeda
    anchors.top: modeButton.top
    anchors.left: modeButton.right
    margin-left: 14
    text: "Moeda: Todas"
    size: 148 48

  UIWidget
    id: sidebarFrame
    size: 232 460
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 10
    margin-left: 12
    margin-bottom: 22
    image-source: assets/ui/panel_navy_dark
    image-border: 14
    image-smooth: true
    phantom: true

  ScrollablePanel
    id: panelCategorias
    anchors.top: sidebarFrame.top
    anchors.bottom: sidebarFrame.bottom
    anchors.left: sidebarFrame.left
    anchors.right: sidebarFrame.right
    margin-top: 10
    margin-bottom: 10
    margin-left: 6
    margin-right: 6
    image-source: ~
    background: alpha
    vertical-scrollbar: panelBar
    layout:
      type: grid
      cell-size: 220 50
      cell-spacing: 6
      flow: false
      num-columns: 1

  ShopVerticalScrollBar
    id: panelBar
    visible: true
    anchors.top: sidebarFrame.top
    anchors.bottom: sidebarFrame.bottom
    anchors.left: sidebarFrame.right
    margin-top: 0
    margin-bottom: 0
    margin-left: 15
    step: 56

  ScrollablePanel
    id: verticalPanel
    anchors.top: modeButton.bottom
    anchors.bottom: sidebarFrame.bottom
    anchors.left: sidebarFrame.right
    anchors.right: parent.right
    margin-top: 14
    margin-left: 52
    margin-right: 52
    image-source: assets/ui/panel_navy_dark
    image-border: 14
    image-smooth: true
    padding: 14
    visible: false
    vertical-scrollbar: verticalBar
    layout:
      type: grid
      cell-spacing: 8
      cell-size: 100 116
      flow: true
      num-columns: 4

  ShopVerticalScrollBar
    id: verticalBar
    anchors.top: verticalPanel.top
    anchors.bottom: verticalPanel.bottom
    anchors.left: verticalPanel.right
    margin-top: 0
    margin-bottom: 0
    margin-left: 15
    step: 40
    pixels-scroll: true
    visible: false

  UIWidget
    id: vipPanel
    anchors.top: modeButton.bottom
    anchors.bottom: sidebarFrame.bottom
    anchors.left: sidebarFrame.right
    anchors.right: parent.right
    margin-top: 14
    margin-left: 52
    margin-right: 52
    image-source: assets/ui/panel_navy_dark
    image-border: 14
    image-smooth: true
    padding: 14
    visible: false

  UIWidget
    id: vipImage
    size: 424 318
    anchors.top: vipPanel.top
    anchors.horizontalCenter: vipPanel.horizontalCenter
    margin-top: 14
    visible: false
    image-source: assets/backgrounds/vipplus
    image-smooth: true
    phantom: true

  UIButton
    id: vip_info
    size: 26 26
    image-source: assets/info
    image-smooth: true
    anchors.top: vipImage.top
    anchors.left: vipImage.left
    margin-top: 12
    margin-left: 12
    visible: false
    change-cursor-image: true
    cursor: pointer

  ScrollablePanel
    id: backgroundClubText
    size: 200 130
    anchors.top: vipImage.top
    anchors.right: vipImage.right
    margin-top: 70
    margin-right: 14
    image-source: assets/ui/panel_navy_inset
    image-border: 12
    image-smooth: true
    text-align: topleft
    vertical-scrollbar: verticalTextBar
    layout: verticalBox
    padding: 10
    visible: false

    UIWidget
      id: text
      font: sono_bold_12
      color: #c5cad6
      size: 170 300
      text-align: topleft
      text-offset: 6 6
      text-wrap: true

  ShopVerticalScrollBar
    id: verticalTextBar
    anchors.top: backgroundClubText.top
    anchors.bottom: backgroundClubText.bottom
    anchors.right: backgroundClubText.right
    margin-top: 6
    margin-bottom: 6
    margin-right: 4
    step: 40
    visible: false

  UILabel
    id: clubBeneficiosTopText
    text: "BENEFICIOS"
    color: #5fe7ff
    text-auto-resize: true
    anchors.bottom: backgroundClubText.top
    anchors.horizontalCenter: backgroundClubText.horizontalCenter
    font: future-earth-16px
    margin-bottom: 6
    visible: false

  ShopButtonGreen
    id: VIP_BUY
    size: 200 48
    anchors.horizontalCenter: backgroundClubText.horizontalCenter
    anchors.top: backgroundClubText.bottom
    margin-top: 14
    visible: false
    text: "COMPRAR VIP"
    @onClick: modules.game_shop.sendBuffer(self:getId())
